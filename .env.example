# ═══════════════════════════════════════════════════════════════════════════
#  BarberShop API — modèle de configuration
#    cp .env.example .env      puis remplir les valeurs
#  Le vrai `.env` ne doit JAMAIS être commité (il contient les secrets).
#  Il est lu :
#   - en dev, par Spring Boot (spring.config.import dans application.yml) ;
#   - par `docker compose` (variables injectées dans les conteneurs).
#  Format : CLE=valeur, sans guillemets ni espaces autour du « = ».
# ═══════════════════════════════════════════════════════════════════════════

# ── Profil Spring ───────────────────────────────────────────────────────────
# dev (défaut en local) : démo activable. prod : validate + Flyway, démo OFF,
# Swagger OFF. docker-compose.yml force prod pour le conteneur.
# (Pris en compte comme variable d'environnement seulement, pas en dev local.)
SPRING_PROFILES_ACTIVE=prod

# ── Base de données ─────────────────────────────────────────────────────────
# En dev : la base PostgreSQL locale. Dans docker compose, DB_URL est remplacée
# automatiquement par celle du conteneur « db ».
DB_URL=jdbc:postgresql://localhost:5432/barbershop
DB_NAME=barbershop
DB_USERNAME=barbershop
# ⚠️ OBLIGATOIRE
DB_PASSWORD=
DB_PORT=5432

# ── Backend ─────────────────────────────────────────────────────────────────
BACKEND_PORT=8080
# Origines autorisées (CORS + WebSocket), séparées par des virgules
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8100
# URL publique de l'API (liens des fichiers uploadés)
APP_PUBLIC_BASE_URL=http://localhost:8080

# ── JWT ─────────────────────────────────────────────────────────────────────
# ⚠️ OBLIGATOIRE — le changer déconnecte tout le monde.
#   openssl rand -base64 64
JWT_SECRET_BASE64=

# ── E-mail (Gmail) ──────────────────────────────────────────────────────────
# Mot de passe d'APPLICATION Google (16 lettres, sans espaces) :
# https://myaccount.google.com/apppasswords
MAIL_USERNAME=
MAIL_PASSWORD=

# ── SMS Twilio (optionnel) ──────────────────────────────────────────────────
# https://console.twilio.com → Account → API keys & tokens
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ── Notifications push Firebase (optionnel) ─────────────────────────────────
# Chemin du fichier JSON de clé de compte de service.
# Vide = src/main/resources/firebase-barberService-account.json en dev ;
# sans clé, l'API démarre avec les push désactivées.
# Docker : voir le volume commenté dans docker-compose.yml.
FIREBASE_CREDENTIALS_FILE=

# ── Connexion Google / Facebook (optionnel) ─────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ── Administrateur système ──────────────────────────────────────────────────
# Créé au premier démarrage s'il n'existe pas (admin@barbershop.local).
# Vide = pas de création automatique.
APP_ADMIN_PASSWORD=

# ── Données de démonstration ────────────────────────────────────────────────
# Dev uniquement (toujours désactivées en prod).
APP_DEMO_DATA_ENABLED=true
