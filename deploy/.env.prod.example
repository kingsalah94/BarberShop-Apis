# ═══ BarberShop — variables de PRODUCTION ═══
# Copier en .env (même dossier) et remplir. Ne JAMAIS commiter le .env.

# ── Domaine (DNS : enregistrement A vers l'IP du serveur) ──
DOMAIN=barbershop.exemple.com
# E-mail pour Let's Encrypt (alertes d'expiration de certificat)
ACME_EMAIL=admin@exemple.com

# ── Base de données ── (openssl rand -base64 32)
DB_NAME=barbershop
DB_USERNAME=barbershop
DB_PASSWORD=

# ── JWT ── (openssl rand -base64 64) — NE PAS réutiliser celui du dev
JWT_SECRET_BASE64=

# ── Compte administrateur système (créé au 1er démarrage) ──
APP_ADMIN_PASSWORD=

# ── E-mail (Gmail : mot de passe d'application) ──
MAIL_USERNAME=
MAIL_PASSWORD=
NOTIFICATION_EMAIL=

# ── Connexion Google ── (mêmes identifiants qu'en dev ; ajouter le SHA-1 release Android)
GOOGLE_WEB_CLIENT_ID=
GOOGLE_CLIENT_IDS=

# ── SMS Twilio (optionnel) ──
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Démo désactivée en prod (de toute façon ignorée par le profil prod)
APP_DEMO_DATA_ENABLED=false
