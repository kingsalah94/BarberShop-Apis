# Copier en secrets.properties (ignoré par git) pour le dev local.
# En prod, utiliser des variables d'environnement du même nom.
DB_PASSWORD=
MAIL_USERNAME=
MAIL_PASSWORD=
# openssl rand -base64 64
JWT_SECRET_BASE64=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
app.admin.password=
app.demo-data.enabled=true
# Push Firebase : chemin d'un fichier de clé de compte de service (hors du dépôt).
# Sans clé, l'API démarre mais les notifications push sont désactivées.
# FIREBASE_CREDENTIALS_FILE=C:/secrets/firebase-barberService-account.json
